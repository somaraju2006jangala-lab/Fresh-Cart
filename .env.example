# FreshCart Environment Variables

# AI Studio / Gemini API Key
GEMINI_API_KEY=
APP_URL=

# ==============================================================================
# FRESHCART SMS PROVIDER CONFIGURATION (Server-side only — never exposed to client)
# Configure either Twilio OR Fast2SMS in Vercel Production Environment / .env:
# ==============================================================================

# Option 1: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS
FAST2SMS_API_KEY=
