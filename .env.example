# FreshCart Environment Variables
# Target Database: MySQL (Local or Cloud-hosted MySQL)

# OPTION A: Discrete MySQL Parameters (Recommended for Aiven, TiDB Cloud, AWS RDS, DigitalOcean)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=freshcart

# OPTION B: Single Connection URL (Supported for Railway, PlanetScale, Supabase, etc.)
# MYSQL_URL=mysql://user:password@host:3306/freshcart
# DATABASE_URL=mysql://user:password@host:3306/freshcart

# SSL / TLS Settings (Automatically enabled for remote cloud hosts, disabled for localhost)
# MYSQL_SSL=true
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Serverless Pool Tuning (Optional, defaults to 5 in production, 10 in dev)
# MYSQL_CONNECTION_LIMIT=5

# Authentication & Security (Required for JWT session tokens)
JWT_SECRET=

# AI Studio / Gemini API Key
GEMINI_API_KEY=
APP_URL=

# PhonePe Payment Gateway (Required for server-signed PhonePe UPI Intent authorization)
# Environment: SANDBOX or PRODUCTION (defaults to SANDBOX)
PHONEPE_ENV=SANDBOX
# Merchant ID issued by PhonePe Business Portal (e.g., M22... or PGTESTPAYUAT)
PHONEPE_MERCHANT_ID=
# API Salt Key provided by PhonePe Merchant Dashboard
PHONEPE_SALT_KEY=
# Salt Index (defaults to 1)
PHONEPE_SALT_INDEX=1
# Server Webhook / Callback URL for asynchronous payment verification
PHONEPE_CALLBACK_URL=
